---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import Icon from '../../components/Icon.astro';

const articles = (await getCollection('articles'))
  .filter(({ data }) => !data.draft && !data.seo.noindex)
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const inquiryUrl = 'https://rx2600.com/#contact';
const audiences = [
  {
    name: 'Physical therapy',
    description: 'Bring a robotic tool to clinician-led physical therapy and soft tissue care.',
    href: '/therapy/robotic-massage-for-physical-therapists/',
    image: '/therapy/media/rx2600-clinicians.jpg',
  },
  {
    name: 'Chiropractic',
    description: 'Add targeted muscular therapy to your clinician-guided approach to care.',
    href: '/therapy/robotic-massage-for-chiropractors/',
    image: '/therapy/media/rpt-treatment.jpg',
  },
  {
    name: 'Sports performance',
    description: 'Bring a technology-forward muscular therapy option to the active communities you serve.',
    href: '/therapy/robotic-massage-for-sports-performance/',
    image: '/therapy/media/rx2600-showcase.jpg',
  },
  {
    name: 'Wellness spaces',
    description: 'Bring clinician-guided robotic muscular therapy to your team, services, and clients.',
    href: inquiryUrl,
    image: '/therapy/media/rx2600-robot.png',
  },
];
---

<SiteLayout
  title="RX2600 for Practices | Robotic Therapy and Practice Growth"
  description="Explore the RX2600 Therapeutic Robot for physical therapy, chiropractic, sports performance, and wellness practices."
  image="/therapy/media/rx2600-clinicians.jpg"
  imageAlt="Clinicians working with the RX2600 Therapeutic Robot"
>
  <section class="marketing-hero" aria-labelledby="hero-heading">
    <img class="hero-photo" src="/therapy/media/rx2600-clinicians.jpg" width="1024" height="683" alt="" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="marketing-hero-content">
      <p class="marketing-kicker">THE RX2600 THERAPEUTIC ROBOT</p>
      <h1 id="hero-heading">Good care has<br />room to grow.</h1>
      <p>Bring clinician-guided robotic therapy into your practice and give your services a new direction for growth.</p>
      <div class="button-group">
        <a class="button button-accent" href={inquiryUrl}>Talk to our team <Icon /></a>
        <a class="button button-outline" href="#why-rx2600">Explore the RX2600 <Icon name="arrow-down" /></a>
      </div>
    </div>
    <span class="hero-photo-caption">ROBOTS + CLINICIANS. BUILT AROUND YOUR PRACTICE.</span>
  </section>

  <section class="business-strip">
    <div><span>THE GROWTH PARTNER PROGRAM</span><p>A new service for your patients. A new direction for your practice.</p></div>
    <a class="button button-dark" href="/therapy/business/">Explore the program <Icon /></a>
  </section>

  <section class="benefits-section" id="why-rx2600">
    <div class="marketing-section-heading">
      <p class="marketing-kicker">WHY RX2600</p>
      <h2>More ways to care.<br />More room to grow.</h2>
      <p>Bring clinical expertise and robotic technology together in a distinctive service designed for your practice.</p>
    </div>
    <div class="benefits-grid">
      <article class="benefit-card">
        <div class="benefit-image"><img src="/therapy/media/rpt-treatment.jpg" alt="A clinician positions the RX2600 treatment head" loading="lazy" /></div>
        <span class="card-number">01 / CLINICAL CARE</span>
        <h3>Clinical expertise, amplified</h3>
        <p>Use the RX2600 as a clinician-guided tool for targeted muscular therapy and soft tissue care.</p>
      </article>
      <article class="benefit-card">
        <div class="benefit-image"><img src="/therapy/media/rx2600-clinicians.jpg" alt="Clinicians working with RX2600 systems" loading="lazy" /></div>
        <span class="card-number">02 / PRACTICE CAPACITY</span>
        <h3>Designed around your workflow</h3>
        <p>Integrate robotic therapy into your team's workflow and support the way you deliver care.</p>
      </article>
      <article class="benefit-card">
        <div class="benefit-image image-product"><img src="/therapy/media/rx2600-robot.png" alt="Close-up of the RX2600 treatment head" loading="lazy" /></div>
        <span class="card-number">03 / A DISTINCTIVE OFFERING</span>
        <h3>A service that stands out</h3>
        <p>Introduce a technology-forward service that adds a new dimension to your practice.</p>
      </article>
      <article class="benefit-card">
        <div class="benefit-image"><img src="/therapy/media/rx2600-showcase.jpg" alt="A clinician using the RX2600 with a patient" loading="lazy" /></div>
        <span class="card-number">04 / BUSINESS GROWTH</span>
        <h3>A new avenue for revenue</h3>
        <p>Introduce a cash-pay service with a business model designed for practice growth.</p>
      </article>
    </div>
  </section>

  <section class="technology-section" id="approach">
    <div class="technology-image">
      <img src="/therapy/media/rpt-treatment.jpg" alt="A clinician using the RX2600 Therapeutic Robot" loading="lazy" />
    </div>
    <div class="technology-copy">
      <p class="marketing-kicker">PRECISION MEETS PRACTICE</p>
      <h2>Your expertise leads.<br />Technology lends a hand.</h2>
      <p>The RX2600 Therapeutic Robot is a tool used by clinicians to assist with muscular therapy and soft tissue mobilization. Your clinical judgment remains at the center of care.</p>
      <a class="button button-dark" href="https://rx2600.com/">Meet the RX2600 <Icon /></a>
    </div>
  </section>

  <section class="audience-section" id="who-its-for">
    <div class="marketing-section-heading">
      <p class="marketing-kicker">DESIGNED FOR YOUR SPACE</p>
      <h2>One tool. Many ways to practice.</h2>
      <p>Bring robotic muscular therapy to the people and communities you serve.</p>
    </div>
    <div class="audience-grid">
      {audiences.map((audience) => (
        <a class="audience-card" href={audience.href}>
          <div class="audience-image"><img src={audience.image} alt="" loading="lazy" /></div>
          <div class="audience-card-copy">
            <h3>{audience.name}</h3>
            <p>{audience.description}</p>
            <span>Explore <Icon /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="partnership-section" id="partnership">
    <div class="partnership-intro">
      <p class="marketing-kicker">THE GROWTH PARTNER PROGRAM</p>
      <h2>Bring the technology.<br />Keep your momentum.</h2>
      <p>Our current program is designed to help practices add RX2600 therapy without purchasing the robot. Talk with our team about eligibility, operational fees, and the details for your practice.</p>
      <a class="button button-accent" href={inquiryUrl}>Discuss your practice <Icon /></a>
    </div>
    <div class="partnership-steps">
      <div><span>01</span><div><h3>Tell us about your practice</h3><p>Share your goals, services, and what you are looking to add.</p></div></div>
      <div><span>02</span><div><h3>Discover the program</h3><p>Discuss the system, your setting, and the current program terms with our team.</p></div></div>
      <div><span>03</span><div><h3>Plan the next step</h3><p>Learn about training and implementation for your practice.</p></div></div>
    </div>
    <p class="program-note">Program availability, eligibility, and terms may vary. A flat-rate operational fee applies. Revenue and results are not guaranteed.</p>
  </section>

  <section class="library-section home-library" id="library" aria-labelledby="home-library-title">
    <div class="section-heading">
      <div>
        <p class="marketing-kicker">THE RX2600 JOURNAL</p>
        <h2 id="home-library-title">Good ideas for growing practices.</h2>
        <a class="archive-link" href="/therapy/articles/">Browse all articles <Icon /></a>
      </div>
      <p class="library-count">{articles.length.toString().padStart(2, '0')} ARTICLES</p>
    </div>
    {articles.length > 0 ? (
      <>
        <div class="journal-module-heading">
          <div><p class="journal-label">EDITOR'S DESK</p><h3>Featured stories.</h3></div>
          <p>Insights, ideas, and technology for ambitious practices.</p>
        </div>
        <ArticleList articles={articles.slice(0, 5)} variant="featured" />
        <div class="journal-module-heading journal-rail-heading">
          <div><p class="journal-label">THE RX2600 COLLECTION</p><h3>Browse the latest.</h3></div>
          <div class="journal-controls" data-journal-controls hidden>
            <button type="button" data-journal-prev aria-label="Previous articles" aria-controls="journal-rail"><Icon name="arrow-left" /></button>
            <button type="button" data-journal-next aria-label="Next articles" aria-controls="journal-rail"><Icon name="arrow-right" /></button>
          </div>
        </div>
        <ArticleList articles={articles} variant="rail" />
      </>
    ) : (
      <div class="empty-state">
        <span class="empty-state-index">COMING SOON</span>
        <h3>Insights for ambitious practices.</h3>
        <p>Our first stories on robotic therapy and practice growth are in the works.</p>
      </div>
    )}
  </section>

  <section class="conversion-section">
    <p class="marketing-kicker">LET'S BUILD WHAT'S NEXT</p>
    <h2>Let's build what's next.</h2>
    <p>Bring RX2600 robotic therapy to your practice. Our team is ready to help you get started.</p>
    <a class="button button-accent" href={inquiryUrl}>Talk to our team <Icon /></a>
  </section>
</SiteLayout>

<script>
  const rail = document.querySelector<HTMLElement>('#journal-rail');
  const controls = document.querySelector<HTMLElement>('[data-journal-controls]');
  const previous = document.querySelector<HTMLButtonElement>('[data-journal-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-journal-next]');

  if (rail && controls && previous && next) {
    const updateControls = () => {
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      controls.hidden = maxScroll <= 1;
      previous.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= maxScroll - 1;
    };
    const scrollRail = (direction: number) => {
      const card = rail.querySelector<HTMLElement>('.article-card');
      if (!card) return;
      const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
      rail.scrollBy({
        left: direction * (card.offsetWidth + gap),
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    };
    previous.addEventListener('click', () => scrollRail(-1));
    next.addEventListener('click', () => scrollRail(1));
    rail.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);
    updateControls();
  }
</script>
