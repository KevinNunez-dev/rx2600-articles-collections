---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ArticleList from '../../components/ArticleList.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) =>
    import.meta.env.DEV || (!data.draft && !data.seo.noindex),
  );

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const sections = headings.filter((heading) => heading.depth === 2);
const relatedIds = article.data.related || [];
const relatedArticles = (await getCollection('articles', ({ data }) => !data.draft && !data.seo.noindex))
  .filter((entry) => entry.id !== article.id && relatedIds.includes(entry.id))
  .sort((a, b) => relatedIds.indexOf(a.id) - relatedIds.indexOf(b.id));
const canonical = article.data.seo.canonical || new URL(`/therapy/${article.id}/`, Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.seo.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: article.data.updatedAt.toISOString(),
  author: { '@type': 'Organization', name: article.data.author },
  mainEntityOfPage: canonical,
  ...(article.data.image ? { image: new URL(article.data.image, Astro.site).toString() } : {}),
};
---

<SiteLayout
  title={`${article.data.seo.title} | RX2600`}
  description={article.data.seo.description}
  canonical={canonical}
  noindex={article.data.draft || article.data.seo.noindex}
  image={article.data.image || undefined}
  imageAlt={article.data.imageAlt || undefined}
>
  <JsonLd data={articleSchema} />
  <article class="article-page">
    <header class:list={['article-hero', { 'article-hero-no-image': !article.data.image }]}>
      <div class="article-hero-copy">
        <a class="article-back" href="/therapy/articles/">← Back to insights</a>
        <p class="article-category">{article.data.category} <span aria-hidden="true">/</span> {article.data.contentType}</p>
        <h1>{article.data.title}</h1>
        <p class="article-deck">{article.data.description}</p>
        <div class="article-byline">
          <span>By {article.data.author}</span>
          <span>{article.data.readingTime} min read</span>
          <time datetime={article.data.updatedAt.toISOString()}>
            Updated {article.data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
      {article.data.image && <div class="article-hero-image"><img src={article.data.image} alt={article.data.imageAlt} /></div>}
    </header>

    {article.data.keyTakeaways.length > 0 && (
      <section class="article-highlights" aria-labelledby="highlights-heading">
        <div class="article-section-heading">
          <p class="marketing-kicker">THE SHORT VERSION</p>
          <h2 id="highlights-heading">Key ideas, at a glance.</h2>
        </div>
        <ul class="highlight-grid">
          {article.data.keyTakeaways.map((item, index) => (
            <li class="highlight-card">
              <span class="highlight-number">{String(index + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="article-reading-layout">
      {sections.length > 0 && (
        <aside class="article-sidebar">
          <nav aria-label="On this page">
            <p class="article-sidebar-label">ON THIS PAGE</p>
            <ol>
              {sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
              {article.data.faq.length > 0 && <li><a href="#article-faq">Frequently asked questions</a></li>}
            </ol>
          </nav>
          <div class="article-sidebar-cta">
            <p>Make your next move.</p>
            <a href="https://rx2600.com/#contact">Talk to our team ↗</a>
          </div>
        </aside>
      )}
      <div class="article-reading-content">
        <div class="prose article-prose">
        <Content />
        </div>
        {article.data.faq.length > 0 && (
          <section class="article-faq" id="article-faq">
            <p class="marketing-kicker">GOOD TO KNOW</p>
            <h2>Frequently asked questions.</h2>
            {article.data.faq.map((item) => (
              <details>
                <summary>{item.question}<span aria-hidden="true"></span></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </section>
        )}
        {article.data.reviewedBy && (
          <p class="review-note">
            Reviewed by {article.data.reviewedBy.name}, {article.data.reviewedBy.credentials} on{' '}
            {article.data.reviewedBy.reviewedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.
          </p>
        )}
        <p class="health-note">This article is for general educational purposes and is not a substitute for professional medical advice.</p>
      </div>
    </div>
  </article>
  {relatedArticles.length > 0 && (
    <section class="library-section related-section">
      <div class="section-heading">
        <div><p class="marketing-kicker">KEEP EXPLORING</p><h2>More ideas for your practice.</h2></div>
        <a class="archive-link" href="/therapy/articles/">View all articles ↗</a>
      </div>
      <ArticleList articles={relatedArticles} />
    </section>
  )}
  <section class="conversion-section">
    <p class="marketing-kicker">EXPLORE THE RX2600</p>
    <h2>See what robotic therapy could bring to your practice.</h2>
    <p>Connect with our team to discuss your goals and explore the right fit.</p>
    <a class="button button-accent" href="https://rx2600.com/#contact">Talk to our team <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
