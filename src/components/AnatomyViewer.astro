---
import type { CollectionEntry } from 'astro:content';

type ModelId = NonNullable<CollectionEntry<'articles'>['data']['anatomyModel']>;

interface Props {
  model: ModelId;
}

const models: Record<ModelId, {
  heading: string;
  title: string;
  uid: string;
  url: string;
  creator: string;
  creatorUrl: string;
  note: string;
  license?: { name: string; url: string };
}> = {
  'pelvic-sacral-plexus': {
    heading: 'Explore the pelvis.',
    title: 'Deep muscles of the pelvis and Sacral plexus',
    uid: 'be6b3bfa96504111b79e5f37ccc27935',
    url: 'https://sketchfab.com/3d-models/deep-muscles-of-the-pelvis-and-sacral-plexus-be6b3bfa96504111b79e5f37ccc27935',
    creator: 'Q.art',
    creatorUrl: 'https://sketchfab.com/Q.art',
    note: 'Anatomy alone cannot identify the cause of sciatica or establish that RX2600 treats sciatica or decompresses a nerve.',
  },
  'lumbar-spine': {
    heading: 'Explore the lower back.',
    title: 'Lumbar Spine',
    uid: 'a45209131d464ad9b4e1a2d7735860fe',
    url: 'https://sketchfab.com/3d-models/lumbar-spine-a45209131d464ad9b4e1a2d7735860fe',
    creator: 'dennislo',
    creatorUrl: 'https://sketchfab.com/dennislo',
    note: 'Anatomy alone cannot identify the cause of back pain or establish that RX2600 cures it.',
    license: { name: 'CC BY 4.0', url: 'https://creativecommons.org/licenses/by/4.0/' },
  },
  'carpal-tunnel': {
    heading: 'Explore the hand and wrist.',
    title: 'All hand bones, muscles, nerves',
    uid: 'e7e3151818a04286a49b1fa428d58931',
    url: 'https://sketchfab.com/3d-models/all-hand-bones-muscles-nerves-e7e3151818a04286a49b1fa428d58931',
    creator: 'mosa-azazmah',
    creatorUrl: 'https://sketchfab.com/mosaazazmah',
    note: 'Anatomy alone cannot diagnose carpal tunnel syndrome or establish that RX2600 relieves median nerve compression.',
  },
};

const selected = models[Astro.props.model];
const embedUrl = `https://sketchfab.com/models/${selected.uid}/embed?autostart=1&ui_infos=0&ui_controls=0`;
---

<section class="anatomy-viewer" id="anatomy-viewer" aria-labelledby="anatomy-title">
  <p class="anatomy-kicker">INTERACTIVE ANATOMY</p>
  <h2 id="anatomy-title">{selected.heading}</h2>
  <p class="anatomy-instruction">Drag to rotate. Scroll or pinch to zoom.</p>
  <div class="anatomy-stage">
    <iframe
      title={`Interactive 3D model: ${selected.title}`}
      src={embedUrl}
      loading="lazy"
      allow="fullscreen; xr-spatial-tracking"
      allowfullscreen
    ></iframe>
  </div>
  <p class="anatomy-note">{selected.note} For educational purposes only.</p>
  <p class="anatomy-credit">
    <a href={selected.url} target="_blank" rel="noopener noreferrer">{selected.title}</a>
    by <a href={selected.creatorUrl} target="_blank" rel="noopener noreferrer">{selected.creator}</a> on
    <a href="https://sketchfab.com" target="_blank" rel="noopener noreferrer">Sketchfab</a>.
    {selected.license && <>Licensed under <a href={selected.license.url} target="_blank" rel="noopener noreferrer">{selected.license.name}</a>; no changes made.</>}
    If the model doesn't load, open the model link above. The embedded viewer connects to Sketchfab.
  </p>
</section>

<style>
  .anatomy-viewer { margin-top: 80px; padding: clamp(24px, 4vw, 36px); border: 1px solid #dce6e8; border-radius: 12px; background: #fff; scroll-margin-top: 110px; }
  .anatomy-kicker { margin: 0 0 16px; color: #087c89; font-size: .68rem; font-weight: 700; letter-spacing: .16em; }
  h2 { margin: 0 0 12px; color: #111820; font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -.045em; line-height: 1.12; }
  .anatomy-instruction, .anatomy-note, .anatomy-credit { color: #52636a; line-height: 1.6; }
  .anatomy-instruction { margin: 0 0 20px; font-size: .9rem; }
  .anatomy-stage { overflow: hidden; border-radius: 10px; background: #101d24; }
  .anatomy-stage iframe { display: block; width: 100%; height: 460px; border: 0; }
  .anatomy-note { margin: 16px 0 0; font-size: .86rem; }
  .anatomy-credit { margin: 12px 0 0; font-size: .79rem; }
  .anatomy-credit a { color: #087c89; text-decoration: underline; }
  @media (max-width: 600px) {
    .anatomy-stage iframe { height: 350px; }
  }
</style>
