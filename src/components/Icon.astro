---
interface Props {
  name?: 'arrow-up-right' | 'arrow-left' | 'arrow-right' | 'arrow-down' | 'check';
}

const { name = 'arrow-up-right' } = Astro.props;
const paths = {
  'arrow-up-right': 'M5 11 11 5M5 5h6v6',
  'arrow-left': 'M13 8H3m0 0 4-4M3 8l4 4',
  'arrow-right': 'M3 8h10m0 0-4-4m4 4-4 4',
  'arrow-down': 'M8 3v10m0 0-4-4m4 4 4-4',
  'check': 'm3 8 3.5 3.5L13 5',
};
---

<svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>
