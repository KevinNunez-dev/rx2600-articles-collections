---
import type { CollectionEntry } from 'astro:content';
import '../styles/practice-landing.css';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const landing = article.data.landing;
if (!landing) throw new Error(`Missing landing page content for ${article.id}`);
---

<article class="practice-landing">
  <section class="practice-hero">
    <div class="practice-hero-copy">
      <a class="practice-back" href="/therapy/articles/">← Back to the library</a>
      <p class="practice-eyebrow"><span></span>{landing.eyebrow}</p>
      <h1>{article.data.title}</h1>
      <p class="practice-hero-lead">{landing.heroLead}</p>
      <div class="button-group">
        <a class="button button-accent" href="https://rx2600.com/#contact">Talk to our team <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="#opportunity">Explore the opportunity <span aria-hidden="true">↓</span></a>
      </div>
      <p class="practice-hero-note">RX2600 Therapeutic Robot · Clinician-guided muscular therapy</p>
    </div>
    <div class="practice-hero-art" aria-hidden="true">
      <div class="practice-art-glow"></div>
      <div class="practice-orbit-fallback"></div>
      <canvas class="practice-orbit" data-practice-orbit></canvas>
      <img src="/therapy/media/rx2600-robot.png" width="1080" height="1080" alt="" />
      <span class="practice-art-label">PRECISION / BUILT FOR PRACTICE</span>
    </div>
  </section>

  <section class="practice-benefits" id="opportunity">
    <div class="practice-section-heading">
      <p class="marketing-kicker">A NEW DIMENSION OF CARE</p>
      <h2>{landing.audienceTitle}</h2>
      <p>{landing.audienceIntro}</p>
    </div>
    <div class="practice-card-grid">
      {landing.benefits.map((benefit, index) => (
        <div class="practice-benefit-card">
          <div class="practice-card-top">
            <span class="practice-card-icon" aria-hidden="true">
              {index === 0 ? (
                <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="11"></circle><circle cx="16" cy="16" r="5"></circle><path d="M16 1v6M16 25v6M1 16h6M25 16h6"></path></svg>
              ) : index === 1 ? (
                <svg viewBox="0 0 32 32" fill="none"><path d="M4 23h24M7 19l6-6 4 4 8-9"></path><path d="M20 8h5v5"></path></svg>
              ) : (
                <svg viewBox="0 0 32 32" fill="none"><path d="M16 3 28 10v12l-12 7L4 22V10z"></path><path d="m4 10 12 7 12-7M16 17v12"></path></svg>
              )}
            </span>
            <span class="practice-card-number">0{index + 1}</span>
          </div>
          <h3>{benefit.title}</h3>
          <p>{benefit.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="practice-fit">
    <div class="practice-fit-image">
      <img src={article.data.image} alt={article.data.imageAlt} loading="lazy" />
      <span>THE RX2600 EXPERIENCE</span>
    </div>
    <div class="practice-fit-copy">
      <p class="marketing-kicker">BUILT AROUND YOUR EXPERTISE</p>
      <h2>{landing.fitTitle}</h2>
      <p>{landing.fitText}</p>
      <ul>{landing.fitPoints.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul>
      <a class="practice-text-link" href="https://rx2600.com/#contact">See if RX2600 is right for you ↗</a>
    </div>
  </section>

  <section class="practice-economics" id="economics">
    <div class="practice-economics-heading">
      <p class="marketing-kicker">THE BUSINESS OPPORTUNITY</p>
      <h2>Explore the numbers.<br /><span>Build your own plan.</span></h2>
      <p>The Growth Partner Program is described by RX2600 as a no-purchase arrangement with a flat-rate operational fee. Ask our team for current eligibility and written terms.</p>
    </div>
    <div class="practice-economics-grid">
      <div class="economics-card economics-model">
        <p class="economics-label">ILLUSTRATIVE SCENARIO</p>
        <p class="economics-amount">$72,000</p>
        <p>Example annual <strong>gross session revenue</strong></p>
        <div class="economics-equation">
          <div><strong>10</strong><span>sessions / week</span></div>
          <span aria-hidden="true">×</span>
          <div><strong>$150</strong><span>per session</span></div>
          <span aria-hidden="true">×</span>
          <div><strong>48</strong><span>weeks / year</span></div>
        </div>
        <p class="economics-disclaimer">Illustration only, not a forecast or guarantee. Gross revenue excludes operational fees, staffing, space, marketing, taxes, cancellations, and other costs. Results vary.</p>
      </div>
      <div class="economics-card economics-costs">
        <p class="economics-label">COSTS &amp; IMPLEMENTATION</p>
        <h3>Know your operating picture.</h3>
        <ul>
          <li><span aria-hidden="true">↗</span><div><strong>No robot purchase</strong><p>Under the described program; eligibility and terms apply.</p></div></li>
          <li><span aria-hidden="true">↗</span><div><strong>Flat-rate operational fee</strong><p>Request the current fee and details for your setting.</p></div></li>
          <li><span aria-hidden="true">↗</span><div><strong>Plan for your own costs</strong><p>Account for staff, space, marketing, and other expenses.</p></div></li>
        </ul>
        <a class="practice-text-link" href="https://rx2600.com/#contact">Request program details ↗</a>
      </div>
    </div>
  </section>

  <section class="practice-faq" aria-labelledby="practice-faq-title">
    <div class="practice-faq-intro"><p class="marketing-kicker">THE DETAILS</p><h2 id="practice-faq-title">Good questions.<br />Clear answers.</h2><p>Start here, then talk with our team about your specific goals.</p></div>
    <div class="practice-faq-list">
      {article.data.faq.map((item) => (
        <details>
          <summary>{item.question}<span aria-hidden="true"></span></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="conversion-section practice-conversion">
    <p class="marketing-kicker">LET'S TALK ABOUT YOUR PRACTICE</p>
    <h2>Ready to make your next move?</h2>
    <p>Explore the technology, the program, and the possibilities for your team.</p>
    <a class="button button-accent" href="https://rx2600.com/#contact">Connect with RX2600 <span aria-hidden="true">↗</span></a>
  </section>
</article>

<script>
  import '../scripts/practice-orbit';
</script>
