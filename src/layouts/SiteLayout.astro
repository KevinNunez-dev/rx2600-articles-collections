---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import Icon from '../components/Icon.astro';
import GuidedAssistant from '../components/GuidedAssistant.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}

const { title, description, canonical, noindex = false, image, imageAlt } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RX2600 Therapy Library',
  url: new URL('/therapy/', Astro.site).toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111312" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/therapy/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RX2600" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).toString()} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <JsonLd data={websiteSchema} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/therapy/" aria-label="RX2600 Therapy home">
        <img src="/therapy/media/rx2600-logo-white.png" alt="" width="1024" height="401" />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/therapy/#why-rx2600">Why RX2600</a>
        <a href="/therapy/#who-its-for">Who it's for</a>
        <a href="/therapy/#partnership">For business</a>
        <a href="/therapy/articles/">Insights</a>
        <form class="header-search" action="/therapy/articles/" method="get" role="search">
          <label class="sr-only" for="header-query">Search articles</label>
          <input id="header-query" name="q" type="search" placeholder="Search articles" />
          <button type="submit" aria-label="Search articles"><Icon /></button>
        </form>
        <a class="nav-cta" href="https://rx2600.com/#contact">Talk to our team <Icon /></a>
      </nav>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="/therapy/#why-rx2600">Why RX2600</a>
          <a href="/therapy/#who-its-for">Who it's for</a>
          <a href="/therapy/#partnership">For business</a>
          <a href="/therapy/articles/">Insights</a>
          <a href="https://rx2600.com/#contact">Talk to our team <Icon /></a>
          <form class="mobile-search" action="/therapy/articles/" method="get" role="search">
            <label for="mobile-query">Search articles</label>
            <div><input id="mobile-query" name="q" type="search" placeholder="Search articles" /><button type="submit">Search</button></div>
          </form>
        </nav>
      </details>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <a class="wordmark footer-wordmark" href="/therapy/">
            <img src="/therapy/media/rx2600-logo-white.png" alt="RX2600 Therapy home" width="1024" height="401" />
          </a>
          <p>Robotic therapy. Human expertise.<br />Built for your practice.</p>
          <a class="footer-contact" href="https://rx2600.com/#contact">Talk to our team <Icon /></a>
        </div>
        <nav class="footer-navigation" aria-label="Footer navigation">
          <div class="footer-column">
            <h2>Discover</h2>
            <a href="/therapy/#why-rx2600">Why RX2600</a>
            <a href="/therapy/#approach">Our technology</a>
            <a href="/therapy/#partnership">Growth Partner Program</a>
            <a href="https://rx2600.com/">RX2600 website <Icon /></a>
          </div>
          <div class="footer-column">
            <h2>For your practice</h2>
            <a href="/therapy/robotic-massage-for-physical-therapists/">Physical therapy</a>
            <a href="/therapy/robotic-massage-for-chiropractors/">Chiropractic</a>
            <a href="/therapy/robotic-massage-for-sports-performance/">Sports performance</a>
            <a href="/therapy/#who-its-for">Wellness spaces</a>
          </div>
          <div class="footer-column">
            <h2>Explore</h2>
            <a href="/therapy/articles/">Article library</a>
            <a href="/therapy/patient-acquisition-system/">Patient acquisition</a>
            <a href="/therapy/increase-revenue-with-robotic-therapy/">Robotic therapy revenue</a>
            <a href="/therapy/increase-revenue-with-rehabilitation-robotics/">Rehabilitation robotics</a>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} RX2600</span>
        <span>Robotic therapy, powered by human expertise.</span>
        <a href="/therapy/">Back to the library home <Icon /></a>
      </div>
    </footer>
    <GuidedAssistant />
  </body>
</html>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
      }
    });
  });
</script>
